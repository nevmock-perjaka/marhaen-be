  "operation": "plus",
  "value": 1,
  "created_by": "admin",
  "updated_by": "admin",
  "owned_by": "tenant-001",
  "created_at": "2025-05-14T00:00:00.000Z",
  "updated_at": "2025-05-14T00:00:00.000Z"
}

### UPDATE add-on config
PUT http://localhost:9990/api/v1/product/addon-config/487be138-76ea-4add-8d24-afdeade14b2c
Content-Type: application/json

{
  "value": 1,
  "updated_by": "admin"
}

### DELETE add-on config
DELETE http://localhost:9990/api/v1/product/addon-config/:addonConfigId