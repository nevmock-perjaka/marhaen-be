generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phone_number    String?
  is_banned       Boolean   @default(false)
  subs_expired_at DateTime?
  subs_level      Int       @default(0)
  tax_percentage  Float     @default(0)
  verified_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles                  Profile[]
  system_logs               SystemLog[]
  subscription_transactions SubscriptionTransaction[]
}

model Profile {
  id      String  @id @default(uuid())
  user_id String
  role    Role
  pin     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

enum Role {
  OWNER
  STAFF
  CASHIER
}

model Otp {
  id         String   @id @default(uuid())
  email      String
  otp_code   Int
  expired_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Plan {
  id        String  @id @default(uuid())
  name      String
  days      Int     @default(30)
  price     Int     @default(0)
  level     Int
  is_active Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SubscriptionTransaction {
  id      String @id @default(uuid())
  user_id String

  level Int // Subscription level
  days  Int // Subscription duration in days

  order_id          String? @unique // Midtrans order_id
  transaction_token String? // Snap token
  redirect_url      String? // URL to redirect to payment page

  gross_amount   Float? // Amount in IDR
  admin_fee      Float? // Admin fee in IDR
  payment_method String? // e.g., 'bank_transfer', 'credit_card', etc.
  status         String? // e.g., 'pending', 'settlement', 'cancel', etc.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model SystemLog {
  id          String  @id @default(uuid())
  user_id     String?
  ip_address  String?
  device      String?
  action      String?
  method      String?
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Product {
  id          String  @id @default(uuid())
  name        String
  price       Float
  description String
  category    String
  image_uri   String
  is_active   Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  order_items        OrderItem[]
  add_on_groups      AddOnGroup[]
  product_configs    ProductConfig[]
  order_item_add_ons OrderItemAddOn[]
  product_discounts  ProductDiscount[]
}

model ProductDiscount {
  id          String   @id @default(uuid())
  product_id  String
  discount_id String
  created_at  DateTime
  updated_at  DateTime
  created_by  String
  updated_by  String
  owned_by    String

  product Product @relation(fields: [product_id], references: [id])
}

model ProductConfig {
  id           String @id @default(uuid())
  product_id   String
  inventory_id String
  operation    String
  value        Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  product   Product   @relation(fields: [product_id], references: [id])
  inventory Inventory @relation(fields: [inventory_id], references: [id])
}

model AddOn {
  id              String  @id @default(uuid())
  add_on_group_id String
  name            String
  price           Float
  is_active       Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  add_on_group   AddOnGroup    @relation(fields: [add_on_group_id], references: [id])
  add_on_configs AddOnConfig[]
}

model AddOnGroup {
  id            String  @id @default(uuid())
  product_id    String
  name          String
  is_required   Boolean
  max_selection Int
  is_active     Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  product Product @relation(fields: [product_id], references: [id])
  add_on  AddOn[]
}

model AddOnConfig {
  id           String @id @default(uuid())
  add_on_id    String
  inventory_id String
  operation    String
  value        Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  add_on    AddOn     @relation(fields: [add_on_id], references: [id])
  inventory Inventory @relation(fields: [inventory_id], references: [id])
}

model Inventory {
  id           String @id @default(uuid())
  product_name String
  description  String
  category     String
  unit_type    String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  input_histories InputHistory[]
  product_configs ProductConfig[]
  add_on_configs  AddOnConfig[]
}

model InputHistory {
  id             String   @id @default(uuid())
  supplier_id    String
  inventory_id   String
  shipping_fee   Float
  price          Float
  total_stock    Int
  current_stock  Int
  input_datetime DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  supplier  Supplier?  @relation(fields: [supplier_id], references: [id])
  inventory Inventory? @relation(fields: [inventory_id], references: [id])
}

model Supplier {
  id           String  @id @default(uuid())
  name         String
  description  String
  address      String
  phone_number String
  Status       Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  input_histories InputHistory[]
}

model Order {
  id           String  @id @default(uuid())
  order_by     String
  phone_number String?
  status       String
  total_gross  Float
  table_id     String?
  discount_id  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  table              Table?             @relation(fields: [table_id], references: [id])
  discount           Discount?          @relation(fields: [discount_id], references: [id])
  order_items        OrderItem[]
  order_item_add_ons OrderItemAddOn[]
  order_transactions OrderTransaction[]
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  price      Float
  note       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Table {
  id               String  @id @default(uuid())
  min_capacity     Int
  max_capacity     Int
  image_uri        String?
  identifier_table String
  is_outdoor       Boolean
  is_active        Boolean
  barcode          String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  order Order[]
}

model OrderItemAddOn {
  id         String @id @default(uuid())
  order_id   String
  product_id String
  price      Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  owned_by   String

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Staff {
  id           String @id @default(uuid())
  name         String
  phone_number String
  is_active    Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  owned_by   String

  staff_logs StaffLog[]
}

model StaffLog {
  id              String   @id @default(uuid())
  staff_id        String
  start_timestamp DateTime
  end_timestamp   DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  owned_by   String

  staff Staff @relation(fields: [staff_id], references: [id])
}
