// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  name      String 
  email     String   @unique
  password  String
  phone_number String?
  is_banned Boolean @default(false)
  subs_expired_at DateTime?
  subs_level Int @default(0)
  tax_percentage Float @default(0)
  verified_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  system_logs SystemLog[]
  subscription_transactions SubscriptionTransaction[]
}

model Otp {
  id        String      @id @default(uuid())
  email String
  otp_code Int
  expired_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Plan {
  id String @id @default(uuid())
  name String
  days Int @default(30)
  price Int @default(0)
  level Int
  is_active Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SubscriptionTransaction {
  id                String             @id @default(uuid())
  user_id           String

  level             Int                // Subscription level
  days              Int                // Subscription duration in days

  order_id          String?             @unique  // Midtrans order_id
  transaction_token String?            // Snap token
  redirect_url      String?            // URL to redirect to payment page

  gross_amount     Float?              // Amount in IDR
  admin_fee        Float?              // Admin fee in IDR
  payment_method   String?             // e.g., 'bank_transfer', 'credit_card', etc.
  status           String?             // e.g., 'pending', 'settlement', 'cancel', etc.

  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  user             User               @relation(fields: [user_id], references: [id])
}

model SystemLog {
  id        String      @id @default(uuid())
  user_id String?
  ip_address String?
  device String?
  action String?
  method String?
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)
}